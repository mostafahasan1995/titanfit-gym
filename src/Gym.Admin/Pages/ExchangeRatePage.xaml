<!--
    Exchange rate: the manager enters today's rate by hand (Syrian pounds for 1 US dollar). Every entry is kept in the
    history; the newest one is used by every PC. Without today's rate the last one is used and the stations warn.
-->
<shell:PageView x:Class="Gym.Admin.Pages.ExchangeRatePage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Gym.UI;assembly=Gym.UI"
                xmlns:shell="clr-namespace:Gym.UI.Shell;assembly=Gym.UI"
                xmlns:controls="clr-namespace:Gym.UI.Controls;assembly=Gym.UI"
                xmlns:pages="clr-namespace:Gym.Admin.Pages">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.85*" MinWidth="320" MaxWidth="440" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Today's rate and the entry form -->
        <!-- The cards scroll on a short window; Save rate stays docked below them. -->
        <DockPanel>
            <Button x:Name="SaveButton" DockPanel.Dock="Bottom" Style="{DynamicResource Button.Primary}" Margin="0,16,0,0" HorizontalAlignment="Left" MinWidth="180"
                    ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Check}" Content="{ui:Loc {x:Static pages:ExchangeRateText.SaveRate}}"
                    Click="OnSaveClick" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <controls:StatusPill x:Name="StatePill" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                <TextBlock Style="{DynamicResource Text.H2}" VerticalAlignment="Center" Text="{ui:Loc {x:Static pages:ExchangeRateText.TodayTitle}}" />
                            </DockPanel>
                            <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                       Text="{ui:Loc {x:Static pages:ExchangeRateText.Intro}}" />

                            <StackPanel x:Name="RatePanel" Orientation="Horizontal" Margin="0,18,0,0">
                                <TextBlock x:Name="RateValue" Style="{DynamicResource Text.Number}" FontSize="34" FontWeight="ExtraBold"
                                           Foreground="{DynamicResource Brush.Gold}" VerticalAlignment="Bottom" />
                                <TextBlock Style="{DynamicResource Text.Caption}" Margin="10,0,0,6" VerticalAlignment="Bottom"
                                           Text="{ui:Loc {x:Static pages:ExchangeRateText.PerDollar}}" />
                            </StackPanel>
                            <TextBlock x:Name="StateText" Style="{DynamicResource Text.Body}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <controls:FormField x:Name="RateField" Label="{ui:Loc {x:Static pages:ExchangeRateText.NewRate}}"
                                                Hint="{ui:Loc {x:Static pages:ExchangeRateText.NewRateHint}}">
                                <TextBox x:Name="RateBox" FlowDirection="LeftToRight" MaxLength="12" Width="220" HorizontalAlignment="Left"
                                         KeyDown="OnRateKeyDown" />
                            </controls:FormField>

                            <Border Style="{DynamicResource Card.Inset}" Margin="0,18,0,0" Padding="14,12">
                                <DockPanel>
                                    <controls:Icon DockPanel.Dock="Left" Data="{x:Static ui:UiIcons.Info}" Size="18" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ExampleText" Style="{DynamicResource Text.Caption}" Margin="10,0,0,0" TextWrapping="Wrap" TextTrimming="None"
                                               Foreground="{DynamicResource Brush.TextTertiary}" />
                                </DockPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- History -->
        <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="12,18,12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,0,4,12">
                    <TextBlock Style="{DynamicResource Text.H2}" Text="{ui:Loc {x:Static pages:ExchangeRateText.HistoryTitle}}" />
                    <TextBlock x:Name="HistoryCount" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                </StackPanel>
                <Grid>
                    <DataGrid x:Name="HistoryGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{ui:Loc {x:Static pages:ExchangeRateText.ColumnDate}}" Width="2*" MinWidth="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Date}" Style="{DynamicResource Text.Strong}" FontSize="14" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{ui:Loc {x:Static pages:ExchangeRateText.ColumnRate}}" Width="1.7*" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Rate}" Style="{DynamicResource Text.Strong}" FontSize="14" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Gold}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{ui:Loc {x:Static pages:ExchangeRateText.ColumnBy}}" Width="1.8*" MinWidth="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding By}" Style="{DynamicResource Text.Body}" FontSize="14" VerticalAlignment="Center"
                                                   FlowDirection="{Binding ByDirection}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{ui:Loc {x:Static pages:ExchangeRateText.ColumnTime}}" Width="0.9*" MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Time}" Style="{DynamicResource Text.Caption}" FontSize="13" VerticalAlignment="Center"
                                                   FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <controls:EmptyState x:Name="HistoryEmpty" Visibility="Collapsed" Icon="{x:Static ui:UiIcons.Cash}"
                                         Title="{ui:Loc {x:Static pages:ExchangeRateText.NoHistory}}"
                                         Text="{ui:Loc {x:Static pages:ExchangeRateText.NoHistoryText}}" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</shell:PageView>
