<!--
    Staff and ratings: everyone who works at the gym (admin, reception, cashier, club trainer), the optional login
    (username, role, password) and the monthly ratings of the club trainers (1 to 5 stars and a note, one per month).
-->
<shell:PageView x:Class="Gym.Admin.Pages.StaffPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Gym.UI;assembly=Gym.UI"
                xmlns:shell="clr-namespace:Gym.UI.Shell;assembly=Gym.UI"
                xmlns:controls="clr-namespace:Gym.UI.Controls;assembly=Gym.UI"
                xmlns:pages="clr-namespace:Gym.Admin.Pages">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="0.6*" MinWidth="280" MaxWidth="380" />
        </Grid.ColumnDefinitions>

        <!-- Staff list -->
        <Border Style="{DynamicResource Card}" Padding="12,18,12,8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="12,0,4,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="InactiveBox" VerticalAlignment="Center" Margin="0,0,16,0"
                                  Content="{ui:Loc {x:Static pages:StaffText.ShowInactive}}"
                                  Checked="OnInactiveChanged" Unchecked="OnInactiveChanged" />
                        <Button Style="{DynamicResource Button.Primary}" ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Plus}"
                                Content="{ui:Loc {x:Static pages:StaffText.AddStaff}}" Click="OnAddClick" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource Text.H2}" Text="{ui:Loc {x:Static pages:StaffText.ListTitle}}" />
                        <TextBlock x:Name="CountText" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <DataGrid x:Name="StaffGrid" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnGridDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{ui:Loc {x:Static pages:StaffText.ColumnName}}" Width="2.5*" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{DynamicResource Text.Strong}" FontSize="14" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{ui:Loc {x:Static pages:StaffText.ColumnJob}}" Width="1.2*" MinWidth="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Job}" Style="{DynamicResource Text.Body}" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextTertiary}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{ui:Loc {x:Static pages:StaffText.ColumnLogin}}" Width="1.5*" MinWidth="82">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Login}" FlowDirection="{Binding LoginFlow}" HorizontalAlignment="Left" FontSize="14"
                                                   Style="{DynamicResource Text.Body}" />
                                        <TextBlock Text="{Binding Role}" Visibility="{Binding RoleVisibility}" Style="{DynamicResource Text.Caption}" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{ui:Loc {x:Static pages:StaffText.ColumnPhone}}" Width="1.3*" MinWidth="76">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Phone}" FlowDirection="LeftToRight" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Style="{DynamicResource Text.Body}" FontSize="14" Foreground="{DynamicResource Brush.TextTertiary}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{ui:Loc {x:Static pages:StaffText.ColumnStatus}}" Width="1.3*" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusPill Tone="{Binding Tone}" Text="{Binding StatusText}" HorizontalAlignment="Left" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- The selected person -->
        <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="22">
            <Grid>
                <Grid x:Name="DetailPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="14" Background="{DynamicResource Brush.AccentSoft}"
                                VerticalAlignment="Top">
                            <controls:Icon x:Name="DetailIcon" Data="{x:Static ui:UiIcons.User}" Size="24" Foreground="{DynamicResource Brush.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailName" Style="{DynamicResource Text.H2}" HorizontalAlignment="Left" TextWrapping="Wrap" TextTrimming="None" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock x:Name="DetailJob" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <controls:StatusPill x:Name="DetailStatus" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Style="{DynamicResource Text.Overline}" Text="{ui:Loc {x:Static pages:StaffText.ColumnPhone}}" />
                            <TextBlock x:Name="DetailPhone" Style="{DynamicResource Text.Body}" FontSize="14" Margin="0,3,0,0" FlowDirection="LeftToRight"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Style="{DynamicResource Text.Overline}" Text="{ui:Loc {x:Static pages:StaffText.ColumnLogin}}" />
                            <TextBlock x:Name="DetailLogin" Style="{DynamicResource Text.Body}" FontSize="14" Margin="0,3,0,0" HorizontalAlignment="Left" />
                            <TextBlock x:Name="DetailRole" Style="{DynamicResource Text.Caption}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Style="{DynamicResource Text.Overline}" Text="{ui:Loc {x:Static pages:StaffText.LastLogin}}" />
                            <TextBlock x:Name="DetailLastLogin" Style="{DynamicResource Text.Body}" FontSize="14" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Style="{DynamicResource Text.Overline}" Text="{ui:Loc {x:Static pages:StaffText.Since}}" />
                            <TextBlock x:Name="DetailSince" Style="{DynamicResource Text.Body}" FontSize="14" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Grid.Row="2" Margin="0,18,0,0">
                        <Button Style="{DynamicResource Button.Secondary}" Padding="16,0" Margin="0,0,10,0"
                                Content="{ui:Loc {x:Static ui:CommonText.Edit}}" Click="OnEditClick" />
                        <Button x:Name="ResetButton" Style="{DynamicResource Button.Secondary}" Padding="16,0" ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Lock}"
                                Content="{ui:Loc {x:Static pages:StaffText.ResetPassword}}" Click="OnResetClick" />
                    </WrapPanel>

                    <!-- Monthly ratings (club trainers) -->
                    <Grid x:Name="RatingsSection" Grid.Row="3" Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{DynamicResource Divider}" Margin="0,0,0,14" />
                        <DockPanel Grid.Row="1" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Style="{DynamicResource Button.Gold}" Padding="14,0" ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Star}"
                                    Content="{ui:Loc {x:Static pages:StaffText.RateMonth}}" Click="OnRateClick" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Style="{DynamicResource Text.Strong}" FontSize="16" Text="{ui:Loc {x:Static pages:StaffText.Ratings}}" />
                                <TextBlock x:Name="AverageText" Style="{DynamicResource Text.Caption}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl x:Name="RatingsList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource Card.Inset}" Padding="14,10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Stars}" Focusable="False" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <controls:Icon Data="{x:Static ui:UiIcons.Star}" Size="16" Margin="1,0">
                                                                        <controls:Icon.Style>
                                                                            <Style TargetType="controls:Icon">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Border}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </controls:Icon.Style>
                                                                    </controls:Icon>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding MonthText}" Style="{DynamicResource Text.Strong}" FontSize="14" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}" Style="{DynamicResource Text.Body}" FontSize="14"
                                                               Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None" Foreground="{DynamicResource Brush.TextTertiary}" />
                                                    <TextBlock Text="{Binding ByText}" Style="{DynamicResource Text.Caption}" FontSize="12" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="RatingsEmpty" Style="{DynamicResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed"
                                       VerticalAlignment="Top" Text="{ui:Loc {x:Static pages:StaffText.NoRatings}}" />
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="NotTrainerText" Grid.Row="3" Margin="0,22,0,0" Style="{DynamicResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                               VerticalAlignment="Top" Text="{ui:Loc {x:Static pages:StaffText.OnlyTrainers}}" />
                </Grid>

                <controls:EmptyState x:Name="NoSelection" Icon="{x:Static ui:UiIcons.Staff}" Visibility="Collapsed" VerticalAlignment="Center"
                                     Title="{ui:Loc {x:Static pages:StaffText.SelectSomeone}}"
                                     Text="{ui:Loc {x:Static pages:StaffText.SelectSomeoneText}}" />
            </Grid>
        </Border>
    </Grid>
</shell:PageView>
