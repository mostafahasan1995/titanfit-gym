<!--
    The admin dashboard (design: design/Admin-Dashboard.dc.html): a backup warning when needed, today's numbers,
    check-ins by hour (LiveCharts2, SkiaSharp), this month's revenue, members expiring soon and low stock.
    It refreshes on the live events (check-ins, members, sales, stock, settings) and once a minute.
-->
<shell:PageView x:Class="Gym.Admin.Pages.DashboardPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Gym.UI;assembly=Gym.UI"
                xmlns:shell="clr-namespace:Gym.UI.Shell;assembly=Gym.UI"
                xmlns:controls="clr-namespace:Gym.UI.Controls;assembly=Gym.UI"
                xmlns:pages="clr-namespace:Gym.Admin.Pages">
    <shell:PageView.Resources>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style x:Key="TileIcon" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Number}">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="TileSub" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </shell:PageView.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="272" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Backup warning -->
        <Border x:Name="BackupBanner" Grid.Row="0" Visibility="Collapsed" CornerRadius="14" BorderThickness="1" Padding="16,12" Margin="0,0,0,16"
                Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.WarningLine}">
            <DockPanel>
                <controls:Icon x:Name="BackupBannerIcon" DockPanel.Dock="Left" Data="{x:Static ui:UiIcons.Alert}" Size="22" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Warning}" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BackupBannerTitle" Style="{DynamicResource Text.Strong}" />
                    <TextBlock x:Name="BackupBannerText" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Today's numbers -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="-6,0">
            <Border Style="{StaticResource Tile}" Margin="6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource TileIcon}" Background="{DynamicResource Brush.AccentSoft}">
                            <controls:Icon Data="{x:Static ui:UiIcons.Scan}" Size="16" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{DynamicResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" Text="{ui:Loc {x:Static pages:DashboardText.CheckInsToday}}" />
                    </StackPanel>
                    <TextBlock x:Name="CheckInsValue" Style="{StaticResource TileValue}" />
                    <TextBlock x:Name="CheckInsSub" Style="{StaticResource TileSub}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Margin="6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource TileIcon}" Background="{DynamicResource Brush.GoodSoft}">
                            <controls:Icon Data="{x:Static ui:UiIcons.Users}" Size="16" Foreground="{DynamicResource Brush.Good}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{DynamicResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" Text="{ui:Loc {x:Static pages:DashboardText.ActiveMembers}}" />
                    </StackPanel>
                    <TextBlock x:Name="ActiveValue" Style="{StaticResource TileValue}" />
                    <TextBlock x:Name="ActiveSub" Style="{StaticResource TileSub}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Margin="6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource TileIcon}" Background="{DynamicResource Brush.WarningSoft}">
                            <controls:Icon Data="{x:Static ui:UiIcons.Clock}" Size="16" Foreground="{DynamicResource Brush.Warning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{DynamicResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" Text="{ui:Loc {x:Static pages:DashboardText.ExpiringSoon}}" />
                    </StackPanel>
                    <TextBlock x:Name="ExpiringValue" Style="{StaticResource TileValue}" />
                    <TextBlock x:Name="ExpiringSub" Style="{StaticResource TileSub}" Foreground="{DynamicResource Brush.Warning}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Margin="6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource TileIcon}" Background="{DynamicResource Brush.BadSoft}">
                            <controls:Icon Data="{x:Static ui:UiIcons.Close}" Size="16" Foreground="{DynamicResource Brush.Bad}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{DynamicResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" Text="{ui:Loc {x:Static pages:DashboardText.Expired}}" />
                    </StackPanel>
                    <TextBlock x:Name="ExpiredValue" Style="{StaticResource TileValue}" />
                    <TextBlock Style="{StaticResource TileSub}" Foreground="{DynamicResource Brush.Bad}" Text="{ui:Loc {x:Static pages:DashboardText.NotRenewed}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Margin="6,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource TileIcon}" Background="{DynamicResource Brush.GoldSoft}">
                            <controls:Icon Data="{x:Static ui:UiIcons.Cash}" Size="16" Foreground="{DynamicResource Brush.Gold}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Style="{DynamicResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" Text="{ui:Loc {x:Static pages:DashboardText.RevenueToday}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <controls:MoneyText x:Name="RevenueValue" ShowCurrency="False" Style="{StaticResource TileValue}" Margin="0" FontSize="26"
                                            Foreground="{DynamicResource Brush.Gold}" VerticalAlignment="Bottom" />
                        <TextBlock Style="{DynamicResource Text.Caption}" Margin="6,0,0,4" VerticalAlignment="Bottom" Text="{ui:Loc {x:Static ui:CommonText.Currency}}" />
                    </StackPanel>
                    <TextBlock x:Name="RevenueSub" Style="{StaticResource TileSub}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Check-ins by hour, and this month's revenue -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="344" />
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource Card}" Padding="20,16,20,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="PeakText" DockPanel.Dock="Right" Style="{DynamicResource Text.Strong}" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Style="{DynamicResource Text.H2}" FontSize="17" Text="{ui:Loc {x:Static pages:DashboardText.ChartTitle}}" />
                    </DockPanel>
                    <Border x:Name="ChartHost" Margin="0,10,0,0" FlowDirection="LeftToRight" />
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.H2}" FontSize="17" Text="{ui:Loc {x:Static pages:DashboardText.MonthTitle}}" />
                    <TextBlock x:Name="MonthRange" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                    <controls:MoneyText x:Name="MonthTotal" Style="{DynamicResource Text.Number}" FontSize="28" Margin="0,12,0,0"
                                        Foreground="{DynamicResource Brush.Gold}" HorizontalAlignment="Left" />
                    <ItemsControl x:Name="MonthRows" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8,0,0">
                                    <DockPanel>
                                        <controls:MoneyText DockPanel.Dock="Right" Amount="{Binding Amount}" Style="{DynamicResource Text.Strong}" FontSize="14" />
                                        <TextBlock Text="{Binding Label}" Style="{DynamicResource Text.Caption}" />
                                    </DockPanel>
                                    <Grid Height="4" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Share}" />
                                            <ColumnDefinition Width="{Binding Rest}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource Brush.Line}" />
                                        <Border CornerRadius="2" Background="{Binding Brush}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Expiring soon, and low stock -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="344" />
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource Card}" Padding="12,16,12,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,6">
                        <TextBlock x:Name="ExpiringTitle" Style="{DynamicResource Text.H2}" FontSize="17" VerticalAlignment="Center" />
                        <TextBlock x:Name="ExpiringCount" Style="{DynamicResource Text.Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <DataGrid x:Name="ExpiringGrid" RowHeight="46">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{ui:Loc {x:Static pages:DashboardText.Member}}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{DynamicResource Text.Strong}" FontSize="14" FlowDirection="{Binding NameDirection}" />
                                                <TextBlock Text="{Binding Number}" Style="{DynamicResource Text.Caption}" Margin="10,0,0,0" FlowDirection="LeftToRight" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{ui:Loc {x:Static pages:DashboardText.Phone}}" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Phone}" Style="{DynamicResource Text.Body}" FontSize="14" Foreground="{DynamicResource Brush.TextTertiary}"
                                                       FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{ui:Loc {x:Static pages:DashboardText.Ends}}" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Ends}" Style="{DynamicResource Text.Body}" FontSize="14" Foreground="{DynamicResource Brush.TextTertiary}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{ui:Loc {x:Static pages:DashboardText.TimeLeft}}" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:StatusPill Tone="Warning" Text="{Binding Left}" HorizontalAlignment="Left" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <controls:EmptyState x:Name="ExpiringEmpty" Visibility="Collapsed" Icon="{x:Static ui:UiIcons.Check}"
                                             Title="{ui:Loc {x:Static pages:DashboardText.NoneExpiring}}"
                                             Text="{ui:Loc {x:Static pages:DashboardText.NoneExpiringText}}" />
                    </Grid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="20,16,20,8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock x:Name="LowCount" DockPanel.Dock="Right" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBlock Style="{DynamicResource Text.H2}" FontSize="17" Text="{ui:Loc {x:Static pages:DashboardText.LowStock}}" />
                    </DockPanel>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl x:Name="LowList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,9">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Background="{Binding SoftBrush}" VerticalAlignment="Center">
                                                    <controls:Icon Data="{x:Static ui:UiIcons.Box}" Size="16" Foreground="{Binding Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{DynamicResource Text.Strong}" FontSize="14" />
                                                    <Grid Height="4" Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding Share}" />
                                                            <ColumnDefinition Width="{Binding Rest}" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource Brush.Line}" />
                                                        <Border CornerRadius="2" Background="{Binding Brush}" />
                                                    </Grid>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <controls:EmptyState x:Name="LowEmpty" Visibility="Collapsed" Icon="{x:Static ui:UiIcons.Box}"
                                             Title="{ui:Loc {x:Static pages:DashboardText.StockOk}}"
                                             Text="{ui:Loc {x:Static pages:DashboardText.StockOkText}}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</shell:PageView>
