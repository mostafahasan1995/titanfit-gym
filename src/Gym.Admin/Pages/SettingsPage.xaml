<!--
    Settings: the gym rules from GET/PUT /api/settings (expiring-soon threshold, private training monthly fee in US dollars,
    rounding step of amounts in Syrian pounds), the
    server and this PC, and a summary of the daily backup (changed on the Backups page).
-->
<shell:PageView x:Class="Gym.Admin.Pages.SettingsPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Gym.UI;assembly=Gym.UI"
                xmlns:shell="clr-namespace:Gym.UI.Shell;assembly=Gym.UI"
                xmlns:controls="clr-namespace:Gym.UI.Controls;assembly=Gym.UI"
                xmlns:pages="clr-namespace:Gym.Admin.Pages">
    <shell:PageView.Resources>
        <Style x:Key="InfoLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </shell:PageView.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Gym rules -->
        <!-- The fields scroll on a short window; Save and Undo stay docked at the bottom of the card. -->
        <Border Style="{DynamicResource Card}" VerticalAlignment="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,18,0,0">
                    <Button x:Name="SaveButton" Style="{DynamicResource Button.Primary}" ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Check}" MinWidth="140"
                            Content="{ui:Loc {x:Static ui:CommonText.Save}}" Click="OnSaveClick" />
                    <Button Style="{DynamicResource Button.Secondary}" Margin="12,0,0,0" Content="{ui:Loc {x:Static pages:SettingsText.Undo}}" Click="OnUndoClick" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.H2}" Text="{ui:Loc {x:Static pages:SettingsText.RulesTitle}}" />
                        <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="{ui:Loc {x:Static pages:SettingsText.RulesText}}" />

                        <controls:FormField x:Name="DaysField" Margin="0,22,0,0" Label="{ui:Loc {x:Static pages:SettingsText.ExpiringDays}}"
                                            Hint="{ui:Loc {x:Static pages:SettingsText.ExpiringDaysHint}}">
                            <TextBox x:Name="DaysBox" FlowDirection="LeftToRight" MaxLength="3" Width="160" HorizontalAlignment="Left" />
                        </controls:FormField>

                        <controls:FormField x:Name="FeeField" Margin="0,18,0,0" Label="{ui:Loc {x:Static pages:SettingsText.PrivateFee}}"
                                            Hint="{ui:Loc {x:Static pages:SettingsText.PrivateFeeHint}}">
                            <TextBox x:Name="FeeBox" FlowDirection="LeftToRight" MaxLength="15" Width="240" HorizontalAlignment="Left" />
                        </controls:FormField>

                        <controls:FormField x:Name="StepField" Margin="0,18,0,0" Label="{ui:Loc {x:Static pages:SettingsText.RoundingStep}}"
                                            Hint="{ui:Loc {x:Static pages:SettingsText.RoundingStepHint}}">
                            <TextBox x:Name="StepBox" FlowDirection="LeftToRight" MaxLength="7" Width="160" HorizontalAlignment="Left" />
                        </controls:FormField>

                        <Border Style="{DynamicResource Card.Inset}" Margin="0,20,0,0" Padding="14,12">
                            <DockPanel>
                                <controls:Icon DockPanel.Dock="Left" Data="{x:Static ui:UiIcons.Info}" Size="18" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" />
                                <TextBlock x:Name="ExampleText" Style="{DynamicResource Text.Caption}" Margin="10,0,0,0" TextWrapping="Wrap" TextTrimming="None"
                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                            </DockPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <!-- Server and this PC -->
                <Border Style="{DynamicResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{x:Static ui:UiIcons.Server}" Size="20" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                            <TextBlock Style="{DynamicResource Text.H2}" Margin="10,0,0,0" Text="{ui:Loc {x:Static pages:SettingsText.ServerTitle}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource InfoLabel}" Text="{ui:Loc {x:Static pages:SettingsText.ServerVersion}}" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource InfoValue}" FlowDirection="LeftToRight" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource InfoLabel}" Text="{ui:Loc {x:Static pages:SettingsText.ServerAddress}}" />
                            <TextBlock x:Name="AddressText" Style="{StaticResource InfoValue}" FlowDirection="LeftToRight" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource InfoLabel}" Text="{ui:Loc {x:Static pages:SettingsText.ThisPc}}" />
                            <TextBlock x:Name="StationText" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource InfoLabel}" Text="{ui:Loc {x:Static pages:SettingsText.SignedIn}}" />
                            <TextBlock x:Name="UserText" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Backups summary -->
                <Border Style="{DynamicResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{x:Static ui:UiIcons.Database}" Size="20" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                            <TextBlock Style="{DynamicResource Text.H2}" Margin="10,0,0,0" Text="{ui:Loc {x:Static pages:SettingsText.BackupTitle}}" />
                            <controls:StatusPill x:Name="BackupPill" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource InfoLabel}" Text="{ui:Loc {x:Static pages:SettingsText.BackupWhen}}" />
                            <TextBlock x:Name="BackupWhen" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource InfoLabel}" Text="{ui:Loc {x:Static pages:SettingsText.BackupFolder}}" />
                            <TextBlock x:Name="BackupFolder" Style="{StaticResource InfoValue}" FlowDirection="LeftToRight" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource InfoLabel}" Text="{ui:Loc {x:Static pages:SettingsText.BackupLast}}" />
                            <TextBlock x:Name="BackupLast" Style="{StaticResource InfoValue}" />
                        </StackPanel>
                        <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,14,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="{ui:Loc {x:Static pages:SettingsText.BackupHint}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</shell:PageView>
