<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Program.Main handles the normal start and the CI screenshot smoke mode. -->
    <StartupObject>Gym.Admin.Program</StartupObject>
    <!-- Per-monitor V2 DPI awareness (shared manifest). -->
    <ApplicationManifest>..\Gym.UI\app.manifest</ApplicationManifest>
    <AssemblyTitle>TITANFIT Admin</AssemblyTitle>
    <!-- Admin app (admin PC: dashboard, management, reports, backups). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Check-ins by hour on the dashboard (SkiaSharp rendering, MIT). -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gym.UI\Gym.UI.csproj" />
    <ProjectReference Include="..\Gym.Client\Gym.Client.csproj" />
  </ItemGroup>

</Project>
