<!--
    Reception check-in (design/Main.dc.html): the webcam reads the member QR (a USB scanner and the member number work
    too), the big card shows photo, name and status in green / amber / red with a sound, and today's recent check-ins
    are below.
-->
<shell:PageView x:Class="Gym.Reception.Pages.CheckInPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Gym.UI;assembly=Gym.UI"
                xmlns:shell="clr-namespace:Gym.UI.Shell;assembly=Gym.UI"
                xmlns:controls="clr-namespace:Gym.UI.Controls;assembly=Gym.UI"
                xmlns:views="clr-namespace:Gym.Reception.Views"
                xmlns:local="clr-namespace:Gym.Reception">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.08*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Camera and manual entry -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <views:CameraView x:Name="Camera" Grid.Row="0" />

            <Border Grid.Row="2" Style="{DynamicResource Card.Inset}" Padding="16,12,16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <controls:FormField x:Name="ManualField" Grid.Column="0" Label="{ui:Loc {x:Static local:ReceptionText.ManualLabel}}">
                        <TextBox x:Name="ManualBox" FlowDirection="LeftToRight" KeyDown="OnManualKeyDown"
                                 ui:ThemeAssist.Placeholder="{ui:Loc {x:Static local:ReceptionText.ManualPlaceholder}}" />
                    </controls:FormField>
                    <Button x:Name="ManualButton" Grid.Column="2" VerticalAlignment="Bottom" ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Check}"
                            Content="{ui:Loc {x:Static local:ReceptionText.CheckInButton}}" Click="OnManualClick" />
                    <controls:FormField Grid.Column="4" Label="{ui:Loc {x:Static local:ReceptionText.CameraLabel}}">
                        <ComboBox x:Name="CameraPicker" SelectionChanged="OnCameraPicked"
                                  ui:ThemeAssist.Placeholder="{ui:Loc {x:Static local:ReceptionText.DefaultCamera}}" />
                    </controls:FormField>
                </Grid>
            </Border>
        </Grid>

        <!-- The result card -->
        <Border x:Name="ResultCard" Grid.Row="0" Grid.Column="2" CornerRadius="20" BorderThickness="1.5"
                Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Line}">
            <Grid>
                <DockPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <!-- Strip: icon, headline, time -->
                    <Border x:Name="ResultStrip" DockPanel.Dock="Top" Padding="22,14" CornerRadius="18,18,0,0">
                        <DockPanel>
                            <Border x:Name="ResultBadge" DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center">
                                <controls:Icon x:Name="ResultIcon" Size="18" StrokeThickness="2.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextOnAccent}" />
                            </Border>
                            <TextBlock x:Name="ResultTime" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="14"
                                       Foreground="{DynamicResource Brush.TextTertiary}" FlowDirection="LeftToRight" />
                            <TextBlock x:Name="ResultHeadline" Margin="12,0" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Heading}"
                                       FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <!-- Footer: note and Renew -->
                    <Border DockPanel.Dock="Bottom" Margin="22,0,22,18" Padding="0,14,0,0" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource Brush.Line}">
                        <DockPanel>
                            <Button x:Name="RenewButton" DockPanel.Dock="Right" Style="{DynamicResource Button.Gold}" Margin="12,0,0,0"
                                    ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Renew}" Click="OnRenewClick"
                                    Content="{ui:Loc {x:Static local:ReceptionText.RenewSubscription}}" />
                            <TextBlock x:Name="ResultNote" VerticalAlignment="Center" FontSize="15" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextTertiary}" />
                        </DockPanel>
                    </Border>

                    <!-- Body -->
                    <Grid Margin="22,18,22,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:Avatar x:Name="ResultPhoto" Width="128" Height="156" ui:ThemeAssist.CornerRadius="16" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="ResultName" FontFamily="{DynamicResource Font.Heading}" FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" MaxHeight="68"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                                <TextBlock x:Name="ResultIdLine" Style="{DynamicResource Text.Caption}" FontSize="14" Margin="0,4,0,0" />
                                <controls:StatusPill x:Name="ResultPill" Margin="0,10,0,0" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{DynamicResource Fact.Caption}" Text="{ui:Loc {x:Static local:ReceptionText.Plan}}" />
                                        <TextBlock x:Name="PlanText" Style="{DynamicResource Fact.Value}" TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{DynamicResource Fact.Caption}" Text="{ui:Loc {x:Static local:ReceptionText.Started}}" />
                                        <TextBlock x:Name="StartText" Style="{DynamicResource Fact.Value}" TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock x:Name="EndCaption" Style="{DynamicResource Fact.Caption}" />
                                        <TextBlock x:Name="EndText" Style="{DynamicResource Fact.Value}" TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,22,0,0" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="DaysNumber" Style="{DynamicResource Text.Display}" FontSize="80" TextTrimming="None"
                                           FlowDirection="LeftToRight" VerticalAlignment="Bottom" />
                                <TextBlock x:Name="DaysCaption" Style="{DynamicResource Text.Caption}" FontSize="15" Margin="12,0,0,16"
                                           VerticalAlignment="Bottom" TextTrimming="None" />
                            </StackPanel>
                            <StackPanel x:Name="UsedPanel" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,18">
                                <Grid Height="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="UsedColumn" Width="0*" />
                                        <ColumnDefinition x:Name="LeftColumn" Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" CornerRadius="4" Background="{DynamicResource Brush.Line}" />
                                    <Border x:Name="UsedBar" Grid.Column="0" CornerRadius="4" />
                                </Grid>
                                <TextBlock x:Name="UsedText" Style="{DynamicResource Text.Caption}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DockPanel>

                <!-- Before the first scan -->
                <controls:EmptyState x:Name="WaitingState" Icon="{x:Static ui:UiIcons.Scan}"
                                     Title="{ui:Loc {x:Static local:ReceptionText.WaitingTitle}}"
                                     Text="{ui:Loc {x:Static local:ReceptionText.WaitingText}}" />
            </Grid>
        </Border>

        <!-- Recent check-ins -->
        <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock x:Name="TodayCountText" DockPanel.Dock="Right" Style="{DynamicResource Text.Caption}" FontSize="14" VerticalAlignment="Bottom" />
                <TextBlock Style="{DynamicResource Text.H2}" Text="{ui:Loc {x:Static local:ReceptionText.RecentTitle}}" />
            </DockPanel>
            <ItemsControl x:Name="RecentList" Focusable="False" Height="168">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,12,12" Height="72" Padding="14,0" HorizontalContentAlignment="Stretch"
                                Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Line}"
                                Click="OnRecentClick" Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:Avatar Width="42" Height="42" ui:ThemeAssist.CornerRadius="21" Source="{Binding Photo}" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               FlowDirection="{Binding NameDirection}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Time}" FontSize="13" FontWeight="Normal" Margin="0,2,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                </StackPanel>
                                <controls:StatusPill Grid.Column="4" Tone="{Binding Tone}" Text="{Binding Label}" FontSize="12" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Grid>
</shell:PageView>
