<!--
    Private trainers: members who train their own clients and pay the private training service (months x the monthly
    fee from the settings). Pay or renew the service, link and unlink clients, add a trainer or change one back.
-->
<shell:PageView x:Class="Gym.Reception.Pages.PrivateTrainersPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Gym.UI;assembly=Gym.UI"
                xmlns:shell="clr-namespace:Gym.UI.Shell;assembly=Gym.UI"
                xmlns:controls="clr-namespace:Gym.UI.Controls;assembly=Gym.UI"
                xmlns:local="clr-namespace:Gym.Reception">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.62*" MinWidth="280" MaxWidth="390" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Trainers -->
        <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="16">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,0,4,10">
                    <TextBlock x:Name="TrainerCount" DockPanel.Dock="Right" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                    <TextBlock Style="{DynamicResource Text.H2}" FontSize="16" Text="{ui:Loc {x:Static local:ReceptionText.PrivateTrainers}}" />
                </DockPanel>
                <Button DockPanel.Dock="Bottom" Margin="0,12,0,0" ui:ThemeAssist.Icon="{x:Static ui:UiIcons.UserPlus}" Click="OnAddTrainerClick"
                        Content="{ui:Loc {x:Static local:ReceptionText.AddTrainer}}" />
                <Grid>
                    <ListBox x:Name="TrainersList" SelectionChanged="OnTrainerSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:Avatar Width="48" Height="48" ui:ThemeAssist.CornerRadius="14" Source="{Binding Photo}" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   FlowDirection="{Binding NameDirection}" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding IdLine}" Style="{DynamicResource Text.Caption}" Margin="0,2,0,4" />
                                        <controls:StatusPill Tone="{Binding ServiceTone}" Text="{Binding ServiceText}" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <controls:EmptyState x:Name="NoTrainers" Visibility="Collapsed" Icon="{x:Static ui:UiIcons.Dumbbell}"
                                         Title="{ui:Loc {x:Static local:ReceptionText.NoTrainersTitle}}"
                                         Text="{ui:Loc {x:Static local:ReceptionText.NoTrainersText}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- The trainer -->
        <Grid Grid.Column="2">
            <Grid x:Name="DetailsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{DynamicResource Card}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:Avatar x:Name="TrainerPhoto" Style="{DynamicResource Avatar.Large}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="TrainerName" FontFamily="{DynamicResource Font.Heading}" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TrainerIdLine" Style="{DynamicResource Text.Caption}" FontSize="14" Margin="0,4,0,0" />
                            <WrapPanel Margin="0,10,0,0">
                                <controls:StatusPill x:Name="ServicePill" Margin="0,0,8,6" />
                                <controls:StatusPill x:Name="MembershipPill" Margin="0,0,8,6" />
                                <TextBlock x:Name="MembershipText" Style="{DynamicResource Text.Caption}" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,6" />
                            </WrapPanel>
                            <TextBlock x:Name="FeeText" Style="{DynamicResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="PayButton" Style="{DynamicResource Button.Gold}" Margin="0,0,8,0" Click="OnPayClick"
                                        ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Cash}" Content="{ui:Loc {x:Static local:ReceptionText.PayPrivate}}" />
                                <Button Click="OnMakeRegularClick" Content="{ui:Loc {x:Static local:ReceptionText.MakeRegular}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="16">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4,0,4,12">
                            <Button DockPanel.Dock="Right" Click="OnLinkClick" ui:ThemeAssist.Icon="{x:Static local:ReceptionIcons.Link}"
                                    Content="{ui:Loc {x:Static local:ReceptionText.LinkClient}}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{DynamicResource Text.H2}" FontSize="16" Text="{ui:Loc {x:Static local:ReceptionText.ClientsTitle}}" />
                                <TextBlock x:Name="ClientCount" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Grid>
                            <ListBox x:Name="ClientsList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:Avatar Width="44" Height="44" ui:ThemeAssist.CornerRadius="12" Source="{Binding Photo}" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           FlowDirection="{Binding NameDirection}" HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding IdLine}" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <controls:StatusPill Grid.Column="4" Status="{Binding Status}" FontSize="12" />
                                            <Button Grid.Column="6" Style="{DynamicResource Button.Ghost}" MinHeight="40" Height="40" FontSize="13"
                                                    Tag="{Binding}" Click="OnUnlinkClick" ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Close}"
                                                    Content="{ui:Loc {x:Static local:ReceptionText.Unlink}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <controls:EmptyState x:Name="NoClients" Visibility="Collapsed" Icon="{x:Static ui:UiIcons.Users}"
                                                 Title="{ui:Loc {x:Static local:ReceptionText.NoClientsTitle}}"
                                                 Text="{ui:Loc {x:Static local:ReceptionText.NoClientsText}}" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <controls:EmptyState x:Name="NoTrainer" Icon="{x:Static ui:UiIcons.Dumbbell}"
                                 Title="{ui:Loc {x:Static local:ReceptionText.NoTrainersTitle}}"
                                 Text="{ui:Loc {x:Static local:ReceptionText.NoTrainersText}}" />
        </Grid>
    </Grid>
</shell:PageView>
