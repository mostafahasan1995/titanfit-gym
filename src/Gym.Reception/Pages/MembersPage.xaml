<!--
    Members: search by name (Arabic-normalized on the server), phone, national number, member number or QR (typed,
    a USB scanner or the webcam), then the member's details, payments and check-ins, with Renew, QR, phone and photo.
-->
<shell:PageView x:Class="Gym.Reception.Pages.MembersPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Gym.UI;assembly=Gym.UI"
                xmlns:shell="clr-namespace:Gym.UI.Shell;assembly=Gym.UI"
                xmlns:controls="clr-namespace:Gym.UI.Controls;assembly=Gym.UI"
                xmlns:views="clr-namespace:Gym.Reception.Views"
                xmlns:local="clr-namespace:Gym.Reception">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Search and results -->
        <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="16">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:SearchBox x:Name="Search" SearchChanged="OnSearchChanged"
                                        ui:ThemeAssist.Placeholder="{ui:Loc {x:Static local:ReceptionText.SearchMembersPlaceholder}}" />
                    <ToggleButton x:Name="ScanToggle" Grid.Column="2" Style="{DynamicResource Button.Icon}" Width="48" Height="48"
                                  ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Qr}" Checked="OnScanToggled" Unchecked="OnScanToggled"
                                  ToolTip="{ui:Loc {x:Static local:ReceptionText.ScanQrToSearch}}" />
                </Grid>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,0">
                    <RadioButton x:Name="FilterAll" Style="{DynamicResource Lang.Toggle}" GroupName="MemberFilter" IsChecked="True"
                                 Content="{ui:Loc {x:Static local:ReceptionText.FilterAll}}" Checked="OnFilterChecked" />
                    <RadioButton x:Name="FilterActive" Style="{DynamicResource Lang.Toggle}" GroupName="MemberFilter" Margin="4,0,0,0"
                                 Content="{ui:Loc {x:Static ui:CommonText.StatusActive}}" Checked="OnFilterChecked" />
                    <RadioButton x:Name="FilterExpiring" Style="{DynamicResource Lang.Toggle}" GroupName="MemberFilter" Margin="4,0,0,0"
                                 Content="{ui:Loc {x:Static ui:CommonText.StatusExpiring}}" Checked="OnFilterChecked" />
                    <RadioButton x:Name="FilterExpired" Style="{DynamicResource Lang.Toggle}" GroupName="MemberFilter" Margin="4,0,0,0"
                                 Content="{ui:Loc {x:Static ui:CommonText.StatusExpired}}" Checked="OnFilterChecked" />
                </StackPanel>

                <Grid x:Name="ScanPanel" DockPanel.Dock="Top" Height="230" Margin="0,12,0,0" Visibility="Collapsed">
                    <views:CameraView x:Name="ScanCamera" />
                </Grid>

                <TextBlock x:Name="CountText" DockPanel.Dock="Top" Style="{DynamicResource Text.Caption}" Margin="4,12,4,6" />

                <Grid>
                    <ListBox x:Name="MembersList" SelectionChanged="OnMemberSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:Avatar Width="44" Height="44" ui:ThemeAssist.CornerRadius="12" Source="{Binding Photo}" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   FlowDirection="{Binding NameDirection}" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding IdLine}" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <controls:StatusPill Grid.Column="4" Status="{Binding Status}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <controls:EmptyState x:Name="NoResults" Visibility="Collapsed"
                                         Title="{ui:Loc {x:Static ui:CommonText.NoResults}}"
                                         Text="{ui:Loc {x:Static ui:CommonText.NoResultsText}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Details -->
        <Grid Grid.Column="2">
            <Grid x:Name="DetailsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{DynamicResource Card}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:Avatar x:Name="DetailPhoto" Width="112" Height="112" ui:ThemeAssist.CornerRadius="18" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="DetailName" FontFamily="{DynamicResource Font.Heading}" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                            <TextBlock x:Name="DetailIdLine" Style="{DynamicResource Text.Caption}" FontSize="14" Margin="0,4,0,0" />
                            <WrapPanel Margin="0,10,0,0">
                                <controls:StatusPill x:Name="DetailPill" Margin="0,0,8,6" />
                                <controls:StatusPill x:Name="TypePill" Tone="Gold" Margin="0,0,8,6" />
                                <TextBlock x:Name="DetailStatus" Style="{DynamicResource Text.Caption}" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,6" />
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="RenewButton" Style="{DynamicResource Button.Gold}" Margin="0,0,8,0" Padding="14,0" FontSize="14" Click="OnRenewClick"
                                        ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Renew}" Content="{ui:Loc {x:Static local:ReceptionText.Renew}}" />
                                <Button Margin="0,0,8,0" Padding="14,0" FontSize="14" Click="OnQrClick" ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Qr}"
                                        Content="{ui:Loc {x:Static local:ReceptionText.ShowQr}}" />
                                <Button Margin="0,0,8,0" Padding="14,0" FontSize="14" Click="OnPhoneClick" ui:ThemeAssist.Icon="{x:Static local:ReceptionIcons.Phone}"
                                        Content="{ui:Loc {x:Static local:ReceptionText.EditPhone}}" />
                                <Button Padding="14,0" FontSize="14" Click="OnPhotoClick" ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Camera}"
                                        Content="{ui:Loc {x:Static local:ReceptionText.ChangePhoto}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="20,16">
                    <UniformGrid x:Name="FactsGrid" Columns="4" Rows="2" />
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="12,14,12,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Text.H2}" FontSize="16" Margin="8,0,8,4"
                                       Text="{ui:Loc {x:Static local:ReceptionText.PaymentsTitle}}" />
                            <DataGrid x:Name="PaymentsGrid">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{ui:Loc {x:Static local:ReceptionText.ColumnWhat}}" Width="1.1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding What}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Months}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{ui:Loc {x:Static local:ReceptionText.ColumnPeriod}}" Width="1.3*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding From}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding To}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{ui:Loc {x:Static local:ReceptionText.ColumnPaid}}" Width="128">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" ToolTip="{Binding PaidDetail}">
                                                    <controls:MoneyText Amount="{Binding Paid}" FontSize="14" />
                                                    <TextBlock Text="{Binding PaidInSyp}" FontSize="12" Visibility="{Binding PaidInSypVisibility}"
                                                               Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="12,14,12,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Text.H2}" FontSize="16" Margin="8,0,8,4"
                                       Text="{ui:Loc {x:Static local:ReceptionText.CheckInsTitle}}" />
                            <DataGrid x:Name="CheckInsGrid">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{ui:Loc {x:Static local:ReceptionText.ColumnWhen}}" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Day}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{ui:Loc {x:Static local:ReceptionText.ColumnResult}}" Width="124">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:StatusPill Tone="{Binding Tone}" Text="{Binding Result}" FontSize="12" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <controls:EmptyState x:Name="NoMember" Icon="{x:Static ui:UiIcons.Users}"
                                 Title="{ui:Loc {x:Static local:ReceptionText.NoMemberTitle}}"
                                 Text="{ui:Loc {x:Static local:ReceptionText.NoMemberText}}" />
        </Grid>
    </Grid>
</shell:PageView>
