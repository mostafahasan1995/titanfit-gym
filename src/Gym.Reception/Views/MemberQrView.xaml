<!--
    The member QR (made from the member's QR code text, the same text check-in reads) with the member number and
    Copy image / Save PNG / Print, so the member can photograph it or staff can send it.
-->
<UserControl x:Class="Gym.Reception.Views.MemberQrView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Gym.UI;assembly=Gym.UI"
             xmlns:local="clr-namespace:Gym.Reception">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Always left-to-right: a mirrored QR code cannot be read. -->
            <Border x:Name="QrTile" Grid.Column="0" Width="148" Height="148" Padding="4" CornerRadius="12" VerticalAlignment="Top"
                    Background="{DynamicResource Brush.Text}" FlowDirection="LeftToRight">
                <Image x:Name="QrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>

            <StackPanel x:Name="InfoPanel" Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="130" MaxWidth="240">
                <TextBlock x:Name="NumberText" FontFamily="{DynamicResource Font.Heading}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                <TextBlock x:Name="NameText" Style="{DynamicResource Text.Caption}" FontSize="13" Margin="0,2,0,8" HorizontalAlignment="Left" />
                <Button x:Name="CopyButton" Margin="0,0,0,6" MinHeight="40" Height="40" Padding="12,0" FontSize="13"
                        Content="{ui:Loc {x:Static local:ReceptionText.CopyImage}}" Click="OnCopyClick" />
                <Button x:Name="SaveButton" Margin="0,0,0,6" MinHeight="40" Height="40" Padding="12,0" FontSize="13"
                        Content="{ui:Loc {x:Static local:ReceptionText.SavePng}}" Click="OnSaveClick" />
                <Button x:Name="PrintButton" MinHeight="40" Height="40" Padding="12,0" FontSize="13"
                        ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Printer}" Content="{ui:Loc {x:Static local:ReceptionText.Print}}" Click="OnPrintClick" />
            </StackPanel>
        </Grid>
        <TextBlock Style="{DynamicResource Text.Caption}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None"
                   Text="{ui:Loc {x:Static local:ReceptionText.QrHelp}}" />
    </StackPanel>
</UserControl>
