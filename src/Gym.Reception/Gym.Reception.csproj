<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Program.Main handles the normal start and the CI screenshot smoke mode. -->
    <StartupObject>Gym.Reception.Program</StartupObject>
    <!-- Per-monitor V2 DPI awareness (shared manifest). -->
    <ApplicationManifest>..\Gym.UI\app.manifest</ApplicationManifest>
    <AssemblyTitle>TITANFIT Reception</AssemblyTitle>
    <!-- Reception app (2 reception PCs: members, ID scan, photos, QR check-in). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Webcam (DirectShow through OpenCV; the Windows x64 native library comes with the runtime package). -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <!-- Member QR: read from camera frames (ZXing.Net) and create the image (QRCoder). -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Check-in sounds (OK, expires soon, denied), generated tones. -->
    <EmbeddedResource Include="Sounds\*.wav" LogicalName="Gym.Reception.Sounds.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gym.UI\Gym.UI.csproj" />
    <ProjectReference Include="..\Gym.Client\Gym.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gym.Tests" />
  </ItemGroup>

  <!-- The camera uses DirectShow only: leave out OpenCV's FFmpeg plug-in (video files and streams, about 29 MB). -->
  <Target Name="DropOpenCvFfmpegPlugin" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="'%(NuGetPackageId)' == 'OpenCvSharp4.runtime.win' And $([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
                                    Condition="'%(NuGetPackageId)' == 'OpenCvSharp4.runtime.win' And $([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
    </ItemGroup>
  </Target>

</Project>
