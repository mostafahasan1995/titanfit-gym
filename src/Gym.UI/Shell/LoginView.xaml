<!--
    Login screen (and, in the Admin app on a fresh server, "create the first admin").
    Full window: language toggle at the top, a card with the logo, the form and the server line.
-->
<UserControl x:Class="Gym.UI.Shell.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Gym.UI"
             xmlns:controls="clr-namespace:Gym.UI.Controls">

    <Grid ClipToBounds="True">
        <!-- A large, faint logo mark behind the card. -->
        <Image Source="{DynamicResource Image.LogoMark}" Opacity="0.05" Height="680" IsHitTestVisible="False"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-140,-160" />

        <DockPanel Margin="28,22" VerticalAlignment="Top" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource Brush.LogoTile}"
                        BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                    <Image Source="{DynamicResource Image.Logo}" Width="36" Height="36" Stretch="Uniform" />
                </Border>
                <controls:Wordmark FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Padding="4" CornerRadius="12" Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                <StackPanel x:Name="LanguageGroup" Orientation="Horizontal">
                    <RadioButton x:Name="EnglishButton" Style="{DynamicResource Lang.Toggle}" GroupName="LoginLanguage"
                                 Content="EN" Checked="OnLanguageChecked" />
                    <RadioButton x:Name="ArabicButton" Style="{DynamicResource Lang.Toggle}" GroupName="LoginLanguage"
                                 Content="عربي" Margin="4,0,0,0" Checked="OnLanguageChecked" />
                </StackPanel>
            </Border>
        </DockPanel>

        <!--
            The card is never taller than the window: logo and title on top, the message, the sign-in button and the
            server line docked at the bottom, the fields scroll between them (the 4 fields of the first admin on a
            short window). On short windows the big logo tile is left out and the spacing is tighter.
        -->
        <Border x:Name="Card" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Padding" Value="40,36" />
                    <Style.Triggers>
                        <Trigger Property="ui:Responsive.IsShort" Value="True">
                            <Setter Property="Padding" Value="36,20" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Border Width="76" Height="76" CornerRadius="22" HorizontalAlignment="Center" Background="{DynamicResource Brush.LogoTile}"
                            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" Margin="0,0,0,16" ui:Responsive.CollapseWhenShort="True">
                        <Image Source="{DynamicResource Image.Logo}" Width="68" Height="68" Stretch="Uniform" />
                    </Border>
                    <controls:Wordmark FontSize="30" HorizontalAlignment="Center" />
                    <TextBlock x:Name="AppNameText" Style="{DynamicResource Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"
                               FontSize="14" />

                    <TextBlock x:Name="TitleText" FontSize="22">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
                                <Setter Property="Margin" Value="0,30,0,0" />
                                <Style.Triggers>
                                    <Trigger Property="ui:Responsive.IsShort" Value="True">
                                        <Setter Property="Margin" Value="0,14,0,0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="SubtitleText" Style="{DynamicResource Text.Caption}" TextWrapping="Wrap" TextTrimming="None"
                               Margin="0,4,0,0" FontSize="14" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border x:Name="MessageBorder" Visibility="Collapsed" CornerRadius="12" Padding="14,10" Margin="0,14,0,0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:Icon x:Name="MessageIcon" Size="18" StrokeThickness="2.2" VerticalAlignment="Top" Margin="0,2,10,0" />
                            <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" FontSize="14"
                                       Foreground="{DynamicResource Brush.Text}" />
                        </Grid>
                    </Border>

                    <Button x:Name="SubmitButton" Style="{DynamicResource Button.Primary}" Height="54" Margin="0,18,0,0" FontSize="16"
                            Click="OnSubmitClick" />

                    <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Margin" Value="0,24,0,0" />
                                <Setter Property="Padding" Value="0,16,0,0" />
                                <Style.Triggers>
                                    <Trigger Property="ui:Responsive.IsShort" Value="True">
                                        <Setter Property="Margin" Value="0,14,0,0" />
                                        <Setter Property="Padding" Value="0,10,0,0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button x:Name="ServerButton" DockPanel.Dock="Right" Style="{DynamicResource Button.Ghost}"
                                    ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Server}" Click="OnServerSettingsClick" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="ServerCaption" Style="{DynamicResource Text.Overline}" />
                                <TextBlock x:Name="ServerText" Style="{DynamicResource Text.Caption}" FlowDirection="LeftToRight"
                                           HorizontalAlignment="Left" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <ScrollViewer Margin="0,18,0,0" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel x:Name="SignInForm">
                            <controls:FormField x:Name="UsernameField">
                                <TextBox x:Name="UsernameBox" KeyDown="OnUsernameKeyDown" />
                            </controls:FormField>
                            <controls:FormField x:Name="PasswordField" Margin="0,16,0,0">
                                <PasswordBox x:Name="PasswordBox" KeyDown="OnPasswordKeyDown" />
                            </controls:FormField>
                        </StackPanel>

                        <StackPanel x:Name="SetupForm" Visibility="Collapsed">
                            <controls:FormField x:Name="SetupNameField">
                                <TextBox x:Name="SetupNameBox" />
                            </controls:FormField>
                            <controls:FormField x:Name="SetupUsernameField" Margin="0,14,0,0">
                                <TextBox x:Name="SetupUsernameBox" />
                            </controls:FormField>
                            <controls:FormField x:Name="SetupPasswordField" Margin="0,14,0,0">
                                <PasswordBox x:Name="SetupPasswordBox" />
                            </controls:FormField>
                            <controls:FormField x:Name="SetupConfirmField" Margin="0,14,0,0">
                                <PasswordBox x:Name="SetupConfirmBox" KeyDown="OnPasswordKeyDown" />
                            </controls:FormField>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
