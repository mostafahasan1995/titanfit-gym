<!--
    The TITANFIT app shell from the design files: sidebar (logo, app name, the app's pages, station, staff, log out)
    and a main area (header with title, date, live connection status, server settings and the EN / عربي toggle;
    the current page below).
-->
<UserControl x:Class="Gym.UI.Shell.AppShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Gym.UI"
             xmlns:controls="clr-namespace:Gym.UI.Controls">

    <Grid x:Name="LayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.SidebarGradient}"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0" Padding="16,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Brush.LogoTile}"
                            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                        <Image Source="{DynamicResource Image.Logo}" Width="40" Height="40" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <controls:Wordmark FontSize="16" HorizontalAlignment="Left" />
                        <TextBlock x:Name="AppNameText" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0"
                        Padding="8,16,8,0">
                    <StackPanel>
                        <TextBlock x:Name="StationText" Style="{DynamicResource Text.Overline}" HorizontalAlignment="Left" />
                        <TextBlock x:Name="StaffText" Style="{DynamicResource Text.Strong}" Margin="0,2,0,0" HorizontalAlignment="Left" />
                        <TextBlock x:Name="RoleText" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                        <Button x:Name="LogoutButton" Style="{DynamicResource Button.Ghost}" Margin="0,12,0,0"
                                HorizontalContentAlignment="Left" ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Logout}"
                                Click="OnLogoutClick" />
                    </StackPanel>
                </Border>

                <ScrollViewer Margin="0,32,0,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl x:Name="NavList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{DynamicResource Nav.Item}" GroupName="ShellNav" Margin="0,0,0,4"
                                             Content="{Binding Label}" Tag="{Binding Icon}"
                                             IsChecked="{Binding IsActive, Mode=TwoWay}"
                                             Checked="OnNavChecked" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="28,18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Today's exchange rate (pounds for 1 dollar); amber while it is an older day's rate. -->
                        <Border x:Name="RateChip" Height="40" Padding="14,0" Margin="0,0,12,0" CornerRadius="12" VerticalAlignment="Center"
                                Visibility="Collapsed" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:Icon x:Name="RateIcon" Data="{x:Static ui:UiIcons.Cash}" Size="16" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Gold}" />
                                <TextBlock x:Name="RateText" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="LiveBorder" Height="40" Padding="14,0" CornerRadius="12" VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="LiveDot" Width="9" Height="9" VerticalAlignment="Center" />
                                <TextBlock x:Name="LiveText" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="ServerButton" Style="{DynamicResource Button.Icon}" Margin="12,0,0,0" Height="40" Width="40" MinHeight="40" MinWidth="40"
                                ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Server}" Click="OnServerSettingsClick" />
                        <Border Margin="12,0,0,0" Padding="4" CornerRadius="12" Background="{DynamicResource Brush.Panel}"
                                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                            <StackPanel x:Name="LanguageGroup" Orientation="Horizontal">
                                <RadioButton x:Name="EnglishButton" Style="{DynamicResource Lang.Toggle}" GroupName="ShellLanguage"
                                             Content="EN" Checked="OnLanguageChecked" />
                                <RadioButton x:Name="ArabicButton" Style="{DynamicResource Lang.Toggle}" GroupName="ShellLanguage"
                                             Content="عربي" Margin="4,0,0,0" Checked="OnLanguageChecked" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Style="{DynamicResource Text.H1}" />
                        <TextBlock x:Name="SubtitleText" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Exchange rate warning: today's rate is missing (the last one is used) or there is none yet. A warning only. -->
            <Border x:Name="RateBanner" Grid.Row="1" Margin="28,16,28,0" Padding="14,10" CornerRadius="14" Visibility="Collapsed"
                    Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.WarningLine}" BorderThickness="1">
                <DockPanel>
                    <controls:Icon DockPanel.Dock="Left" Data="{x:Static ui:UiIcons.Alert}" Size="20" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Warning}" />
                    <TextBlock x:Name="RateBannerText" Style="{DynamicResource Text.Strong}" FontSize="14" Margin="10,0,0,0"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- The current page. -->
            <ContentControl x:Name="PageHost" Grid.Row="2" Margin="28,24,28,28" Focusable="False"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>

        <!-- Thin aqua-to-turquoise accent line along the top. -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Height="2" VerticalAlignment="Top"
                Background="{DynamicResource Brush.AccentGradient}" IsHitTestVisible="False" />
    </Grid>
</UserControl>
