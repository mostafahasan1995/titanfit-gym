<!-- Server settings (station.json): server address with "Test connection", and the station name. -->
<UserControl x:Class="Gym.UI.Shell.ServerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Gym.UI"
             xmlns:controls="clr-namespace:Gym.UI.Controls">
    <StackPanel>
        <controls:FormField x:Name="ServerField">
            <TextBox x:Name="ServerBox" FlowDirection="LeftToRight" />
        </controls:FormField>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="TestButton" Style="{DynamicResource Button.Secondary}" ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Server}"
                    Click="OnTestClick" />
            <StackPanel x:Name="TestResult" Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <controls:Icon x:Name="TestIcon" Size="18" StrokeThickness="2.4" VerticalAlignment="Center" />
                <TextBlock x:Name="TestText" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap" MaxWidth="300" />
            </StackPanel>
        </Grid>

        <controls:FormField x:Name="StationField" Margin="0,20,0,0">
            <TextBox x:Name="StationBox" />
        </controls:FormField>

        <TextBlock x:Name="FileText" Style="{DynamicResource Text.Overline}" Margin="2,18,2,0" TextWrapping="Wrap" TextTrimming="None" />
    </StackPanel>
</UserControl>
