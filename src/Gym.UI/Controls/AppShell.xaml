<!--
    The TITANFIT app shell from the design files: sidebar (logo, app name, pages, station, log out)
    and a main area (header with title, date, server status and the EN / عربي toggle; content below).
-->
<UserControl x:Class="Gym.UI.Controls.AppShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Gym.UI"
             xmlns:controls="clr-namespace:Gym.UI.Controls"
             Background="{DynamicResource Brush.Background}"
             Foreground="{DynamicResource Brush.Text}"
             FontFamily="{DynamicResource Font.Body}"
             FontSize="14"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             NumberSubstitution.Substitution="European">

    <Grid x:Name="LayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.SidebarGradient}"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0" Padding="16,24">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Brush.LogoTile}"
                            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                        <Image Source="{DynamicResource Image.Logo}" Width="40" Height="40" Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <controls:Wordmark FontSize="16" HorizontalAlignment="Left" />
                        <TextBlock x:Name="AppNameText" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl x:Name="NavList" DockPanel.Dock="Top" Margin="0,32,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{DynamicResource Nav.Item}" GroupName="ShellNav" Margin="0,0,0,4"
                                         Content="{Binding Label}" Tag="{Binding Icon}"
                                         IsChecked="{Binding IsActive, Mode=OneTime}"
                                         Checked="OnNavChecked" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0"
                        Padding="8,16,8,0">
                    <StackPanel>
                        <TextBlock x:Name="StationText" Style="{DynamicResource Text.Overline}" />
                        <TextBlock x:Name="StaffText" Style="{DynamicResource Text.Strong}" Margin="0,2,0,0" />
                        <TextBlock x:Name="RoleText" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                        <Button x:Name="LogoutButton" Style="{DynamicResource Button.Ghost}" Margin="0,12,0,0"
                                HorizontalContentAlignment="Left" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{DynamicResource Icon.Line}" Data="{x:Static ui:UiIcons.Logout}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="LogoutText" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="28,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                        <Border Margin="16,0,0,0" Padding="4" CornerRadius="12" Background="{DynamicResource Brush.Panel}"
                                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                            <StackPanel x:Name="LanguageGroup" Orientation="Horizontal">
                                <RadioButton x:Name="EnglishButton" Style="{DynamicResource Lang.Toggle}" GroupName="ShellLanguage"
                                             Content="EN" Checked="OnLanguageChecked" />
                                <RadioButton x:Name="ArabicButton" Style="{DynamicResource Lang.Toggle}" GroupName="ShellLanguage"
                                             Content="عربي" Margin="4,0,0,0" Checked="OnLanguageChecked" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Style="{DynamicResource Text.H1}" />
                        <TextBlock x:Name="SubtitleText" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content: an on-brand placeholder until the real screens arrive (steps 3 to 5). -->
            <Border Grid.Row="1" Margin="28,24,28,28" CornerRadius="20" Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <Image Source="{DynamicResource Image.LogoMark}" Height="160" HorizontalAlignment="Center" />
                    <controls:Wordmark FontSize="44" HorizontalAlignment="Center" Margin="0,24,0,0" />
                    <TextBlock x:Name="PlaceholderTitle" Style="{DynamicResource Text.H2}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,28,0,0" />
                    <TextBlock x:Name="PlaceholderText" Style="{DynamicResource Text.Body}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Thin aqua-to-turquoise accent line along the top. -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Height="2" VerticalAlignment="Top"
                Background="{DynamicResource Brush.AccentGradient}" IsHitTestVisible="False" />
    </Grid>
</UserControl>
