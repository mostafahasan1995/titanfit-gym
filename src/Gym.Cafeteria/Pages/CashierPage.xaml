<!--
    The cashier (POS) screen, after design/Cafeteria-POS.dc.html: low-stock banner, search / barcode box, category tabs and
    big product tiles on the left; the order (cart with + and −, cash received, change, total, Charge) on the right.
    A USB barcode scanner in keyboard mode works anywhere on this screen (see Hardware/BarcodeWedge.cs).
    Logic: Sales/CashierViewModel.cs. Strings: CafeteriaText.cs.
-->
<shell:PageView x:Class="Gym.Cafeteria.Pages.CashierPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Gym.UI;assembly=Gym.UI"
                xmlns:shell="clr-namespace:Gym.UI.Shell;assembly=Gym.UI"
                xmlns:controls="clr-namespace:Gym.UI.Controls;assembly=Gym.UI"
                xmlns:local="clr-namespace:Gym.Cafeteria"
                xmlns:pages="clr-namespace:Gym.Cafeteria.Pages"
                xmlns:sales="clr-namespace:Gym.Cafeteria.Sales">
    <shell:PageView.Resources>
        <!-- A product tile: panel card, accent border while the item is in the cart. -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="MinHeight" Value="148" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" />
                            <Border x:Name="Overlay" Background="Transparent" CornerRadius="16" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Brush.Pressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A category tab: a pill with the name and the number of items. -->
        <Style x:Key="CategoryChip" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="22" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The − and + buttons of a cart line. -->
        <Style x:Key="Stepper" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ui:ThemeAssist.CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Brush.Panel2}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </shell:PageView.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="404" />
        </Grid.ColumnDefinitions>

        <!-- Items -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Low-stock warning (also on the Stock screen). -->
            <Border x:Name="LowStockBanner" Grid.Row="0" Margin="0,0,0,14" Padding="14,8" CornerRadius="14" Visibility="Collapsed"
                    Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.WarningLine}" BorderThickness="1">
                <DockPanel>
                    <controls:Icon DockPanel.Dock="Left" Data="{x:Static ui:UiIcons.Alert}" Size="20" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Warning}" />
                    <TextBlock x:Name="LowStockTitle" DockPanel.Dock="Left" Style="{DynamicResource Text.Strong}" FontSize="14" Margin="10,0,14,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LowStockMore" DockPanel.Dock="Right" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                    <ItemsControl x:Name="LowStockList" Focusable="False" VerticalAlignment="Center" ClipToBounds="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pages:LowStockChip}">
                                <Border Margin="0,0,8,0" Padding="10,4" CornerRadius="10" Background="{DynamicResource Brush.Panel}"
                                        BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Brush.Text}" MaxWidth="150"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Stock}" FontSize="13" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource Font.Heading}" Foreground="{DynamicResource Brush.Warning}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Search or scan -->
            <StackPanel Grid.Row="1">
                <TextBlock Style="{DynamicResource Text.Label}" Text="{ui:Loc {x:Static local:CafeteriaText.SearchLabel}}" />
                <controls:SearchBox x:Name="SearchInput" Margin="0,6,0,0" SearchChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"
                                    ui:ThemeAssist.Placeholder="{ui:Loc {x:Static local:CafeteriaText.SearchPlaceholder}}" />
            </StackPanel>

            <!-- Category tabs -->
            <ItemsControl x:Name="CategoryList" Grid.Row="2" Margin="0,14,0,8" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type sales:CategoryTab}">
                        <RadioButton Style="{StaticResource CategoryChip}" GroupName="CashierCategory" Margin="0,0,8,6"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="OnCategoryChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Count}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Product tiles -->
            <ScrollViewer x:Name="TileScroller" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" SizeChanged="OnTilesSizeChanged" Margin="-6,0,-6,0">
                <Grid>
                    <ItemsControl x:Name="TileList" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding TileColumns, RelativeSource={RelativeSource AncestorType={x:Type pages:CashierPage}}}"
                                             VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type sales:ProductTile}">
                                <Button Click="OnTileClick" IsEnabled="{Binding CanAdd}"
                                        AutomationProperties.Name="{Binding AccessibleName}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Tile}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInCart}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Left"
                                                Background="{DynamicResource Brush.AccentSoft}">
                                            <controls:Icon Data="{Binding Icon}" Size="24" Foreground="{DynamicResource Brush.Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Row="0" MinWidth="30" Height="28" Padding="8,0" CornerRadius="14" HorizontalAlignment="Right"
                                                VerticalAlignment="Top" Background="{DynamicResource Brush.Accent}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInCart}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding InCartText}" FontSize="13" FontWeight="Bold" FlowDirection="LeftToRight"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextOnAccent}" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,8"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" LineHeight="20"
                                                   LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource Brush.Text}" />
                                        <StackPanel Grid.Row="2">
                                            <controls:MoneyText Amount="{Binding Price}" FontFamily="{DynamicResource Font.Heading}" FontSize="17"
                                                                FontWeight="Bold" Foreground="{DynamicResource Brush.Gold}" HorizontalAlignment="Left" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static sales:StockState.Low}">
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static sales:StockState.Out}">
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Bad}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <controls:Icon Data="{x:Static ui:UiIcons.Box}" Size="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StockText}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <controls:EmptyState x:Name="NoTiles" Visibility="Collapsed" Margin="0,40,0,0" VerticalAlignment="Top"
                                         Title="{ui:Loc {x:Static ui:CommonText.NoResults}}"
                                         Text="{ui:Loc {x:Static local:CafeteriaText.NoItemsFound}}" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Order -->
        <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="20">
            <DockPanel>
                <!-- Header: title, item count, Clear -->
                <DockPanel DockPanel.Dock="Top">
                    <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{DynamicResource Button.Ghost}" VerticalAlignment="Center"
                            ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Trash}" Content="{ui:Loc {x:Static ui:CommonText.Clear}}" Click="OnClearClick" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource Text.H2}" FontSize="20" FontWeight="Bold" Text="{ui:Loc {x:Static local:CafeteriaText.CurrentOrder}}" />
                        <TextBlock x:Name="ItemCountText" Style="{DynamicResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- The current shift -->
                <Border DockPanel.Dock="Top" Style="{DynamicResource Card.Inset}" Padding="12,10" Margin="0,14,0,0">
                    <DockPanel>
                        <controls:Icon DockPanel.Dock="Left" Data="{x:Static ui:UiIcons.Clock}" Size="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        <controls:MoneyText x:Name="ShiftTotalText" DockPanel.Dock="Right" FontFamily="{DynamicResource Font.Heading}" FontSize="15"
                                            FontWeight="Bold" Foreground="{DynamicResource Brush.Gold}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ShiftTitleText" Style="{DynamicResource Text.Strong}" FontSize="14" />
                            <TextBlock x:Name="ShiftDetailText" Style="{DynamicResource Text.Caption}" FontSize="12" Margin="0,1,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Footer: cash, change, total, Charge (hidden after a sale) -->
                <StackPanel x:Name="OrderFooter" DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Style="{DynamicResource Text.Label}" Text="{ui:Loc {x:Static local:CafeteriaText.CashReceived}}" />
                    <TextBox x:Name="CashInput" Margin="0,6,0,0" FlowDirection="LeftToRight" InputScope="Number" TextChanged="OnCashChanged"
                             ui:ThemeAssist.Placeholder="{ui:Loc {x:Static local:CafeteriaText.CashPlaceholder}}" />
                    <ItemsControl x:Name="QuickCashList" Margin="-3,8,-3,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="3,0" MinHeight="44" Padding="4,0" FontSize="14" Click="OnQuickCashClick">
                                    <controls:MoneyText Amount="{Binding}" ShowCurrency="False" FlowDirection="LeftToRight" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,10,0,0" MinHeight="26">
                        <TextBlock x:Name="ChangeLabel" Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.TextTertiary}"
                                   VerticalAlignment="Center" Text="{ui:Loc {x:Static local:CafeteriaText.Change}}" />
                        <controls:MoneyText x:Name="ChangeText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            FontFamily="{DynamicResource Font.Heading}" FontSize="18" FontWeight="Bold"
                                            Foreground="{DynamicResource Brush.Good}" />
                        <TextBlock x:Name="CashErrorText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" Visibility="Collapsed"
                                   Foreground="{DynamicResource Brush.Bad}" Text="{ui:Loc {x:Static local:CafeteriaText.CashTooLow}}" />
                    </DockPanel>
                    <Border Style="{DynamicResource Divider}" Margin="0,12" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{DynamicResource Text.Body}" Foreground="{DynamicResource Brush.TextTertiary}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,8" Text="{ui:Loc {x:Static local:CafeteriaText.TotalCash}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <controls:MoneyText x:Name="TotalText" ShowCurrency="False" FontFamily="{DynamicResource Font.Heading}" FontSize="36"
                                                FontWeight="ExtraBold" VerticalAlignment="Bottom" />
                            <TextBlock Text="{ui:Loc {x:Static ui:CommonText.Currency}}" Style="{DynamicResource Text.Caption}" FontSize="14"
                                       Margin="8,0,0,8" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </DockPanel>
                    <Button x:Name="ChargeButton" Style="{DynamicResource Button.Gold}" Margin="0,12,0,0" MinHeight="64" FontSize="18"
                            ui:ThemeAssist.CornerRadius="16" ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Cash}" Click="OnChargeClick" />
                </StackPanel>

                <!-- Cart lines, the empty state, or the paid state -->
                <Grid Margin="0,8,0,0">
                    <ScrollViewer x:Name="LinesScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl x:Name="LineList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type sales:CartLine}">
                                    <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" MinWidth="78" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left"
                                                           TextWrapping="Wrap" LineHeight="19" LineStackingStrategy="BlockLineHeight" MaxHeight="38"
                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <controls:MoneyText Amount="{Binding UnitPrice}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                    <TextBlock Text="{ui:Loc {x:Static local:CafeteriaText.Each}}" FontSize="12" Margin="4,0,0,0"
                                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ShortText}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource Brush.Bad}" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsShort}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="3" CornerRadius="12" VerticalAlignment="Center"
                                                    Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Click="OnDecreaseClick" AutomationProperties.Name="{Binding DecreaseName}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource Stepper}">
                                                                <Setter Property="ui:ThemeAssist.Icon" Value="{x:Static ui:UiIcons.Minus}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Quantity}" Value="1">
                                                                        <Setter Property="ui:ThemeAssist.Icon" Value="{x:Static ui:UiIcons.Trash}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <TextBlock Text="{Binding Quantity}" MinWidth="32" TextAlignment="Center" VerticalAlignment="Center"
                                                               FontFamily="{DynamicResource Font.Heading}" FontSize="16" FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.Text}" />
                                                    <Button Style="{StaticResource Stepper}" ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Plus}"
                                                            IsEnabled="{Binding CanIncrease}" Click="OnIncreaseClick" AutomationProperties.Name="{Binding IncreaseName}" />
                                                </StackPanel>
                                            </Border>
                                            <controls:MoneyText Grid.Column="2" Amount="{Binding LineTotal}" ShowCurrency="False" FontSize="15" FontWeight="SemiBold"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight"
                                                                Foreground="{DynamicResource Brush.Text}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border x:Name="EmptyCart" CornerRadius="16" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5"
                            Padding="24" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <controls:Icon Data="{x:Static ui:UiIcons.Barcode}" Size="40" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Style="{DynamicResource Text.Caption}" FontSize="14" Margin="0,12,0,0" MaxWidth="260"
                                       TextWrapping="Wrap" TextAlignment="Center" Text="{ui:Loc {x:Static local:CafeteriaText.EmptyCart}}" />
                        </StackPanel>
                    </Border>

                    <!-- Paid: the receipt number, the change, printing, New order -->
                    <Border x:Name="PaidPanel" CornerRadius="16" Padding="20" Visibility="Collapsed"
                            Background="{DynamicResource Brush.GoodSoft}" BorderBrush="{DynamicResource Brush.GoodLine}" BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom">
                                <Button x:Name="ReprintButton" Style="{DynamicResource Button.Secondary}" ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Printer}"
                                        Content="{ui:Loc {x:Static local:CafeteriaText.ReprintReceipt}}" Click="OnReprintClick" />
                                <Button Style="{DynamicResource Button.Primary}" Margin="0,10,0,0" MinHeight="64" FontSize="18" ui:ThemeAssist.CornerRadius="16"
                                        ui:ThemeAssist.Icon="{x:Static ui:UiIcons.Cart}" Content="{ui:Loc {x:Static local:CafeteriaText.NewOrder}}"
                                        Click="OnNewOrderClick" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="60" Height="60" CornerRadius="30" Background="{DynamicResource Brush.Good}" HorizontalAlignment="Center">
                                    <controls:Icon Data="{x:Static ui:UiIcons.Check}" Size="32" StrokeThickness="2.4"
                                                   Foreground="{DynamicResource Brush.TextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Style="{DynamicResource Text.H2}" FontSize="22" FontWeight="Bold" Margin="0,14,0,0" HorizontalAlignment="Center"
                                           Text="{ui:Loc {x:Static local:CafeteriaText.PaidInCash}}" />
                                <TextBlock x:Name="PaidDetailText" Style="{DynamicResource Text.Body}" Margin="0,6,0,0" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                                <StackPanel x:Name="PaidChangePanel" Margin="0,18,0,0" HorizontalAlignment="Center">
                                    <TextBlock Style="{DynamicResource Text.Caption}" HorizontalAlignment="Center" Text="{ui:Loc {x:Static local:CafeteriaText.ChangeToGive}}" />
                                    <controls:MoneyText x:Name="PaidChangeText" HorizontalAlignment="Center" Margin="0,4,0,0" FontFamily="{DynamicResource Font.Heading}"
                                                        FontSize="34" FontWeight="ExtraBold" Foreground="{DynamicResource Brush.Gold}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <controls:Icon x:Name="PrintIcon" Data="{x:Static ui:UiIcons.Printer}" Size="18" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock x:Name="PrintStatusText" Style="{DynamicResource Text.Caption}" Margin="8,0,0,0" MaxWidth="280"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</shell:PageView>
