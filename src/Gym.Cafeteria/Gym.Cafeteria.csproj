<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Program.Main handles the normal start and the CI screenshot smoke mode. -->
    <StartupObject>Gym.Cafeteria.Program</StartupObject>
    <!-- Per-monitor V2 DPI awareness (shared manifest). -->
    <ApplicationManifest>..\Gym.UI\app.manifest</ApplicationManifest>
    <AssemblyTitle>TITANFIT Cafeteria</AssemblyTitle>
    <!-- Cafeteria app (2 cafeteria PCs: cashier and stock). -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gym.UI\Gym.UI.csproj" />
    <ProjectReference Include="..\Gym.Client\Gym.Client.csproj" />
  </ItemGroup>

</Project>
