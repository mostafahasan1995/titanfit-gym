<!-- New item / Edit item: names in English and Arabic, category, price, barcode (a scan types it here), minimum stock, active. -->
<UserControl x:Class="Gym.Cafeteria.Forms.ProductForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Gym.UI;assembly=Gym.UI"
             xmlns:controls="clr-namespace:Gym.UI.Controls;assembly=Gym.UI"
             xmlns:local="clr-namespace:Gym.Cafeteria">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:FormField x:Name="NameEnField" Grid.Row="0" Grid.Column="0" Label="{ui:Loc {x:Static local:CafeteriaText.NameEnglish}}">
            <TextBox x:Name="NameEnInput" FlowDirection="LeftToRight" MaxLength="200" />
        </controls:FormField>
        <controls:FormField x:Name="NameArField" Grid.Row="0" Grid.Column="2" Label="{ui:Loc {x:Static local:CafeteriaText.NameArabic}}">
            <TextBox x:Name="NameArInput" FlowDirection="RightToLeft" MaxLength="200" />
        </controls:FormField>

        <controls:FormField x:Name="CategoryField" Grid.Row="1" Grid.Column="0" Margin="0,14,0,0" Label="{ui:Loc {x:Static local:CafeteriaText.Category}}">
            <ComboBox x:Name="CategoryInput" />
        </controls:FormField>
        <controls:FormField x:Name="PriceField" Grid.Row="1" Grid.Column="2" Margin="0,14,0,0" Label="{ui:Loc {x:Static local:CafeteriaText.PriceUsd}}">
            <TextBox x:Name="PriceInput" FlowDirection="LeftToRight" InputScope="Number" />
        </controls:FormField>

        <controls:FormField x:Name="BarcodeField" Grid.Row="2" Grid.Column="0" Margin="0,14,0,0" Label="{ui:Loc {x:Static local:CafeteriaText.Barcode}}"
                            Hint="{ui:Loc {x:Static local:CafeteriaText.BarcodeHint}}">
            <TextBox x:Name="BarcodeInput" FlowDirection="LeftToRight" MaxLength="64" />
        </controls:FormField>
        <controls:FormField x:Name="MinField" Grid.Row="2" Grid.Column="2" Margin="0,14,0,0" Label="{ui:Loc {x:Static local:CafeteriaText.MinStock}}"
                            Hint="{ui:Loc {x:Static local:CafeteriaText.MinStockHint}}">
            <TextBox x:Name="MinInput" FlowDirection="LeftToRight" InputScope="Number" />
        </controls:FormField>

        <CheckBox x:Name="ActiveInput" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0" IsChecked="True"
                  Content="{ui:Loc {x:Static local:CafeteriaText.ActiveForSale}}" />
        <TextBlock x:Name="FormError" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap"
                   Visibility="Collapsed" Foreground="{DynamicResource Brush.Bad}" />
    </Grid>
</UserControl>
